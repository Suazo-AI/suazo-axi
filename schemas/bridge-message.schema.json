{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suazo-axi.local/schemas/bridge-message.schema.json",
  "title": "suazo-axi host bridge message",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" }],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["bridge", "id", "service", "resource", "action"],
      "properties": {
        "bridge": { "const": "0.1" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "service": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "resource": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "params": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["bridge", "id", "ok"],
      "properties": {
        "bridge": { "const": "0.1" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "ok": { "type": "boolean" },
        "items": { "type": "array" },
        "total": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "error": {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": { "enum": ["unauthenticated", "unavailable", "not-found", "invalid-request", "rate-limited", "internal"] },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        { "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] }, "then": { "required": ["items"] } },
        { "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] }, "then": { "required": ["error"] } }
      ],
      "additionalProperties": false
    }
  }
}
