{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suazo-axi.local/schemas/result-envelope.schema.json",
  "title": "suazo-axi result envelope",
  "type": "object",
  "required": ["axi", "ok", "command", "data", "meta", "help"],
  "properties": {
    "axi": { "type": "string" },
    "ok": { "type": "boolean" },
    "command": { "type": "string" },
    "data": {},
    "meta": { "type": "object" },
    "help": { "type": "array", "items": { "type": "string" } },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    { "if": { "properties": { "ok": { "const": false } } }, "then": { "required": ["error"] } }
  ],
  "additionalProperties": false
}
