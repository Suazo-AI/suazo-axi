{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suazo-axi.local/schemas/service-manifest.schema.json",
  "title": "suazo-axi service manifest",
  "type": "object",
  "required": ["id", "domain", "transport", "phase", "status", "capabilities"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "domain": { "type": "string" },
    "transport": { "type": "string" },
    "phase": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "enum": ["planned", "future"] }] },
    "status": { "enum": ["implemented", "planned", "host-bridge-required", "unconfigured"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resource", "actions", "mutation"],
        "properties": {
          "resource": { "type": "string" },
          "actions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "mutation": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
